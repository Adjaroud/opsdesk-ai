OPSDESK_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Laisser vide pour utiliser le modèle par défaut du fournisseur choisi.
OPSDESK_LLM_MODEL=
# Délai de lecture par décision LLM : vide = Gemini 60 s, OpenAI 25 s.
OPSDESK_LLM_TIMEOUT_SECONDS=
OPSDESK_DB=data/opsdesk.db
OPSDESK_API_URL=http://127.0.0.1:18000
